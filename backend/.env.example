# InvoiceFlow configuration.
#
# Copy to .env and fill in. Only DATABASE_URL and JWT_SECRET are required —
# everything else has a working default.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# PostgreSQL. A managed database (Neon, Supabase, RDS) works as-is; SSL is used
# unless the URL says sslmode=disable, which is what a local database wants.
DATABASE_URL=postgresql://user:password@host:5432/invoiceflow
# DATABASE_URL=postgresql://postgres@127.0.0.1:5432/invoiceflow?sslmode=disable

# Signs the session tokens. Any long random string; changing it signs everyone
# out.
JWT_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# SERVER
# ---------------------------------------------------------------------------

PORT=4000

# ---------------------------------------------------------------------------
# AI EXTRACTION
#
# Reads invoices and handwritten stock sign-out sheets. Without a key the app
# still runs — extraction falls back to a mock so the workflow can be walked
# through, and it says so on screen.
# ---------------------------------------------------------------------------

# gemini | claude | mock
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# A field read less confidently than this is flagged for review.
CONFIDENCE_THRESHOLD=0.85

# ---------------------------------------------------------------------------
# STOCK
# ---------------------------------------------------------------------------

# Whether a movement may take a product below zero. Leave false so a sign-out
# sheet asking for more than there is stops for a person.
STOCK_ALLOW_NEGATIVE=false

# A product match at or above this is taken automatically...
STOCK_MATCH_THRESHOLD=0.9

# ...unless the runner-up is within this margin, which makes it ambiguous and
# sends it to review instead of guessing between two similar products.
STOCK_MATCH_MARGIN=0.08

# Sign-out sheets: a reading at or above ACCEPT is taken, below REVIEW a person
# must decide. These sit on top of the hard rules — a confident reading of a
# product that is not in the master is still rejected.
STOCK_SHEET_ACCEPT_THRESHOLD=0.95
STOCK_SHEET_REVIEW_THRESHOLD=0.8

# ---------------------------------------------------------------------------
# FIRST ADMINISTRATOR (optional)
#
# Only used by `node seed.js`, for creating the first account without opening a
# browser. Normally the first person to register becomes the administrator.
# ---------------------------------------------------------------------------

# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# COMPANY_NAME=
